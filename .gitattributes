# SDK identity hashes production input bytes; keep them identical on both hosts.
/Cargo.toml text eol=lf
/Cargo.lock text eol=lf
/rust-toolchain.toml text eol=lf
/src/** text=auto eol=lf
/crates/**/Cargo.toml text eol=lf
/crates/**/build.rs text eol=lf
/crates/**/src/** text=auto eol=lf

# Canonical lock fixtures must retain the schema's exact LF wire encoding.
/tests/fixtures/package-lock/*.json text eol=lf
