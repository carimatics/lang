// The last strong owner expires immediately, while weak metadata stays usable.
fn main() -> i64 {
    let mut owner: shared i64 = core::result_unwrap::<shared i64, core::OwnershipError>(core::shared_new::<i64>(core::allocator(), 9));
    let mut observer: weak i64 = core::result_unwrap::<weak i64, core::OwnershipError>(core::weak_new::<i64>(owner));
    let mut dropped: core::Unit = core::drop::<shared i64>(owner);
    match core::weak_upgrade::<i64>(observer) {
        core::Result::Ok(_) => { return -1; },
        core::Result::Err(error) => {
            match error {
                core::OwnershipError::ExpiredWeak => { return 42; },
                _ => { return -2; },
            }
        },
    }
}
