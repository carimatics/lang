fn fail(code: i64) -> i64 {
    let mut stopped: core::Unit = core::panic::<core::Unit>(code + 0);
}

fn main() -> i64 {
    let mut bytes: core::Bytes = core::result_unwrap::<core::Bytes, core::AllocError>(core::bytes_new(core::allocator()));
    let mut pushed: core::Unit = core::result_unwrap::<core::Unit, core::BufferError>(core::bytes_push(bytes, 7));
    return fail(-42);
}
