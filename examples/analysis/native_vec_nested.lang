// Nested owning vectors retain parent element loans through child operations.
fn main() -> i64 {
    let mut inner: core::Vec<core::Bytes> = core::result_unwrap::<core::Vec<core::Bytes>, core::AllocError>(core::vec_new::<core::Bytes>(core::allocator()));
    let mut first: core::Unit = core::result_unwrap::<core::Unit, core::AllocError>(core::vec_push::<core::Bytes>(inner, make()));
    let mut outer: core::Vec<core::Vec<core::Bytes>> = core::result_unwrap::<core::Vec<core::Vec<core::Bytes>>, core::AllocError>(core::vec_new::<core::Vec<core::Bytes>>(core::allocator()));
    let mut row: core::Unit = core::result_unwrap::<core::Unit, core::AllocError>(core::vec_push::<core::Vec<core::Bytes>>(outer, inner));
    match core::vec_get_mut::<core::Vec<core::Bytes>>(outer, 0) {
        core::Result::Ok(values) => {
            let mut added: core::Unit = core::result_unwrap::<core::Unit, core::AllocError>(core::vec_push::<core::Bytes>(values, make()));
            match core::vec_get_mut::<core::Bytes>(values, 0) {
                core::Result::Ok(value) => {
                    let mut grown: core::Unit = core::result_unwrap::<core::Unit, core::BufferError>(core::bytes_push(value, 66));
                    (*value) = make();
                },
                core::Result::Err(_) => { return -1; },
            }
        },
        core::Result::Err(_) => { return -2; },
    }
    let mut removed: core::Vec<core::Bytes> = core::option_unwrap::<core::Vec<core::Bytes>>(core::vec_pop::<core::Vec<core::Bytes>>(outer));
    let mut last: core::Bytes = core::option_unwrap::<core::Bytes>(core::vec_pop::<core::Bytes>(removed));
    match core::vec_pop::<core::Vec<core::Bytes>>(outer) {
        core::Option::Some(_) => { return -3; },
        core::Option::None => {},
    }
    match core::vec_get::<core::Bytes>(removed, 0) {
        core::Result::Ok(kept) => { return core::vec_len::<core::Bytes>(removed) + core::bytes_len(kept) + core::bytes_len(last); },
        core::Result::Err(_) => { return -4; },
    }
}

fn make() -> core::Bytes {
    let mut value: core::Bytes = core::result_unwrap::<core::Bytes, core::AllocError>(core::bytes_new(core::allocator()));
    let mut pushed: core::Unit = core::result_unwrap::<core::Unit, core::BufferError>(core::bytes_push(value, 65));
    return value;
}
