struct Node { edges: core::Vec<shared Node> }
fn make() -> shared Node {
    let mut edges: core::Vec<shared Node> = core::result_unwrap::<core::Vec<shared Node>, core::AllocError>(core::vec_new::<shared Node>(core::allocator()));
    return core::result_unwrap::<shared Node, core::OwnershipError>(core::shared_new::<Node>(core::allocator(), Node { edges: edges }));
}
fn main() -> i64 {
    let mut left: shared Node = make();
    let mut right: shared Node = make();
    let mut edges: core::Vec<shared Node> = core::result_unwrap::<core::Vec<shared Node>, core::AllocError>(core::vec_new::<shared Node>(core::allocator()));
    let mut left_edge: shared Node = core::result_unwrap::<shared Node, core::OwnershipError>(core::shared_clone::<Node>(left));
    let mut pushed: core::Result<core::Unit, core::AllocError> = core::vec_push::<shared Node>(edges, left_edge);
    let mut changed: core::Result<core::Unit, core::OwnershipError> = core::shared_replace::<Node>(right, Node { edges: edges });
    let mut back: core::Vec<shared Node> = core::result_unwrap::<core::Vec<shared Node>, core::AllocError>(core::vec_new::<shared Node>(core::allocator()));
    let mut right_edge: shared Node = core::result_unwrap::<shared Node, core::OwnershipError>(core::shared_clone::<Node>(right));
    let mut back_pushed: core::Result<core::Unit, core::AllocError> = core::vec_push::<shared Node>(back, right_edge);
    let mut cycle: core::Result<core::Unit, core::OwnershipError> = core::shared_replace::<Node>(left, Node { edges: back });
    match cycle { core::Result::Ok(_) => { return -1; }, core::Result::Err(error) => {
        match error { core::OwnershipError::StrongCycle => { return 23; }, _ => { return -2; }, }
    }, }
