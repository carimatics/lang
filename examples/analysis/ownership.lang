// Analyze with: cargo run -- check examples/analysis/ownership.lang
// Ownership execution is a later Milestone 2 outcome.
fn main() -> i64 {
    let mut created: core::Result<core::Bytes, core::AllocError> =
        core::bytes_new(core::allocator());
    match created {
        core::Result::Ok(bytes) => { return core::bytes_len(bytes); },
        core::Result::Err(_) => { return 0; },
    }
}
