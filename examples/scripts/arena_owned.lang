// Same-region cycle, owning replacement and nested checked reads.
struct Node { bytes: core::Bytes, next: core::Option<arena Node> }

fn make(count: i64) -> core::Bytes {
    let mut bytes: core::Bytes = core::result_unwrap::<core::Bytes, core::AllocError>(core::bytes_new(core::allocator()));
    let mut i: i64 = 0;
    while i < count {
        let mut pushed: core::Result<core::Unit, core::BufferError> = core::bytes_push(bytes, i);
        i = i + 1;
    }
    return bytes;
}

fn main() -> i64 {
    arena graph(core::allocator()) {
        let mut first: arena Node = core::result_unwrap::<arena Node, core::ArenaError>(core::arena_new::<Node>(graph, Node { bytes: make(1), next: core::Option::None }));
        let mut second: arena Node = core::result_unwrap::<arena Node, core::ArenaError>(core::arena_new::<Node>(graph, Node { bytes: make(2), next: core::Option::Some(first) }));
        let mut changed: core::Result<core::Unit, core::ArenaError> = core::arena_replace::<Node>(graph, first, Node { bytes: make(3), next: core::Option::Some(second) });
        match core::arena_read::<Node>(graph, first) {
            core::Result::Ok(node) => {
                match node.next {
                    core::Option::Some(next) => {
                        match core::arena_read::<Node>(graph, next) {
                            core::Result::Ok(peer) => { return core::bytes_len(node.bytes) + core::bytes_len(peer.bytes); },
                            core::Result::Err(_) => { return -1; },
                        }
                    },
                    core::Option::None => { return -2; },
                }
            },
            core::Result::Err(_) => { return -3; },
        }
    }
}
