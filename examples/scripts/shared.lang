fn main() -> i64 {
    let mut made: core::Result<shared i64, core::OwnershipError> = core::shared_new::<i64>(core::allocator(), 9);
    let mut owner: shared i64 = core::result_unwrap::<shared i64, core::OwnershipError>(made);
    match core::shared_read::<i64>(owner) {
        core::Result::Ok(value) => { return (*value); },
        core::Result::Err(_) => { return -1; },
    }
}
