struct Pair { left: core::Bytes, right: core::Bytes }

fn make(count: i64) -> core::Bytes {
    let mut value: core::Bytes = core::result_unwrap::<core::Bytes, core::AllocError>(core::bytes_new(core::allocator()));
    let mut index: i64 = 0;
    while index < count {
        let mut pushed: core::Result<core::Unit, core::BufferError> = core::bytes_push(value, 65);
        index = index + 1;
    }
    return value;
}

fn width(value: &Pair) -> i64 { return core::bytes_len(value.left) + core::bytes_len(value.right); }

fn main() -> i64 {
    let mut values: core::Vec<Pair> = core::result_unwrap::<core::Vec<Pair>, core::AllocError>(core::vec_new::<Pair>(core::allocator()));
    let mut index: i64 = 0;
    while index < 5 {
        let mut added: core::Result<core::Unit, core::AllocError> = core::vec_push::<Pair>(values, Pair { right: make(2), left: make(1) });
        index = index + 1;
    }
    match core::vec_get_mut::<Pair>(values, 0) {
        core::Result::Ok(pair) => {
            let mut grew: core::Result<core::Unit, core::BufferError> = core::bytes_push(pair.left, 66);
            pair.right = make(3);
        },
        core::Result::Err(_) => { return -1; },
    }
    let mut last: Pair = core::option_unwrap::<Pair>(core::vec_pop::<Pair>(values));
    match core::vec_get::<Pair>(values, 0) {
        core::Result::Ok(first) => { return core::vec_len::<Pair>(values) + width(first) + width(last); },
        core::Result::Err(_) => { return -2; },
    }
}
