struct Store { bytes:core::Bytes }
struct Packet { stored:shared Store, observer:weak Store, receivers:core::Vec<core::Receiver<core::Bytes>> }

fn bytes(value:i64)->core::Bytes {
    let mut value_bytes:core::Bytes=core::result_unwrap::<core::Bytes,core::AllocError>(core::bytes_new(core::allocator()));
    let mut pushed:core::Unit=core::result_unwrap::<core::Unit,core::BufferError>(core::bytes_push(value_bytes,value));
    return value_bytes;
}

async fn producer(sender:core::Sender<Packet>)->i64 {
    let mut leaf:core::ChannelSetup<core::Bytes>=core::result_unwrap::<core::ChannelSetup<core::Bytes>,core::ChannelError>(core::channel_new::<core::Bytes>(core::allocator(),1));
    let mut leaf_sender:core::Sender<core::Bytes>=core::channel_sender::<core::Bytes>(&leaf);
    let mut leaf_receiver:core::Receiver<core::Bytes>=core::channel_receiver::<core::Bytes>(leaf);
    let mut seeded:core::SendResult<core::Bytes>=await core::channel_send::<core::Bytes>(&leaf_sender,bytes(9));
    let mut receivers:core::Vec<core::Receiver<core::Bytes>>=core::result_unwrap::<core::Vec<core::Receiver<core::Bytes>>,core::AllocError>(core::vec_new::<core::Receiver<core::Bytes>>(core::allocator()));
    let mut pushed:core::Unit=core::result_unwrap::<core::Unit,core::AllocError>(core::vec_push::<core::Receiver<core::Bytes>>(receivers,leaf_receiver));
    let mut stored:shared Store=core::result_unwrap::<shared Store,core::OwnershipError>(core::shared_new::<Store>(core::allocator(),Store { bytes:bytes(42) }));
    let mut observer:weak Store=core::result_unwrap::<weak Store,core::OwnershipError>(core::weak_new::<Store>(stored));
    let mut sent:core::SendResult<Packet>=await core::channel_send::<Packet>(&sender,Packet { stored:stored,observer:observer,receivers:receivers });
    return 0;
}

async fn consumer(receiver:core::Receiver<Packet>)->i64 {
    let mut active:core::Receiver<Packet>=receiver;
    let mut incoming:core::Option<Packet>=await core::channel_receive::<Packet>(&mut active);
    let mut packet:Packet=core::option_unwrap::<Packet>(incoming);
    let mut result:i64=0;
    match core::shared_read::<Store>(packet.stored) {
        core::Result::Ok(view) => { result=core::result_unwrap::<i64,core::BoundsError>(core::bytes_get(view.bytes,0)); },
        core::Result::Err(_) => { return -1; },
    }
    return result;
}

async fn main()->i64 {
    let mut setup:core::ChannelSetup<Packet>=core::result_unwrap::<core::ChannelSetup<Packet>,core::ChannelError>(core::channel_new::<Packet>(core::allocator(),1));
    let mut sender:core::Sender<Packet>=core::channel_sender::<Packet>(&setup);
    let mut receiver:core::Receiver<Packet>=core::channel_receiver::<Packet>(setup);
    let mut producing:core::Task<i64>=spawn producer(sender);
    let mut consuming:core::Task<i64>=spawn consumer(receiver);
    let mut sent:i64=core::result_unwrap::<i64,core::TaskError>(await producing);
    return sent+core::result_unwrap::<i64,core::TaskError>(await consuming);
}
