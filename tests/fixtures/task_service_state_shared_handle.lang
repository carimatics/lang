struct Outbox { handle:core::ServiceHandle<core::Receiver<i64>> }
struct State { stored:shared Outbox, observer:weak Outbox, inbox:core::Receiver<i64> }

fn clone_handle(stored:&shared Outbox)->core::ServiceHandle<core::Receiver<i64>> {
    match core::shared_read::<Outbox>(stored) {
        core::Result::Ok(view)=>{ return core::service_clone::<core::Receiver<i64>>(&view.handle); },
        core::Result::Err(error)=>{ return core::panic::<core::ServiceHandle<core::Receiver<i64>>>(-9); },
    }
}

